---
import { profile, navLinks } from '../data/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line/70 bg-bg/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
    <a href="/" class="flex items-center gap-2.5 font-mono text-sm font-medium tracking-tight">
      <img
        src={profile.photo}
        alt=""
        width="64"
        height="64"
        class="h-8 w-8 rounded-lg border border-accent/40 object-cover transition-transform duration-300 hover:scale-105"
      />
      <span class="hidden sm:inline">{profile.name}</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a href={link.href} class:list={['nav-link text-[13px] font-medium', { 'is-active': isActive(link.href) }]}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Switch to dark mode"
        class="icon-btn grid h-9 w-9 place-items-center rounded-lg border border-line text-muted"
      >
        <svg class="theme-icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="theme-icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <a
        href="/contact"
        class="btn btn-ghost hidden rounded-lg px-4 py-2 text-[13px] font-medium sm:inline-flex"
      >
        Let's connect
        <span class="arrow ml-1.5" aria-hidden="true">↗</span>
      </a>

      <button
        id="nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="icon-btn grid h-9 w-9 place-items-center rounded-lg border border-line text-muted md:hidden"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg px-5 pb-5 pt-2 md:hidden">
    <nav class="flex flex-col" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['border-b border-line/60 py-3 text-sm text-muted last:border-0', { 'text-accent': isActive(link.href) }]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
