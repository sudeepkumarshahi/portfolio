<div class="pb-10 pt-4">
  <canvas id="typing-lottie" class="ml-5 block h-20 w-20 sm:ml-8 sm:h-24 sm:w-24" aria-label="Keyboard typing animation"></canvas>
</div>

<script>
  import { DotLottie } from '@lottiefiles/dotlottie-web';

  let animation: DotLottie | undefined;

  function initTypingAnimation() {
    const canvas = document.getElementById('typing-lottie') as HTMLCanvasElement | null;
    animation?.destroy();
    animation = undefined;
    if (!canvas) return;

    animation = new DotLottie({
      canvas,
      src: '/keyboard-typing.lottie',
      autoplay: !window.matchMedia('(prefers-reduced-motion: reduce)').matches,
      loop: true,
      backgroundColor: 'transparent',
      renderConfig: { autoResize: true },
    });
  }

  document.addEventListener('astro:page-load', initTypingAnimation);
  initTypingAnimation();
</script>
