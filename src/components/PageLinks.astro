---
import SectionHeading from './SectionHeading.astro';
import Reveal from './Reveal.astro';
import { pageLinks } from '../data/site';
---

<section class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <SectionHeading title="Where to next?" note="Each part of my portfolio has its own page." />

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {pageLinks.map((link, index) => (
        <Reveal delay={index * 70} class="h-full">
          <a
            href={link.href}
            class="group flex h-full flex-col justify-between rounded-xl border border-line bg-bg p-5 transition-all duration-300 hover:-translate-y-1 hover:border-accent hover:shadow-sm sm:p-6"
          >
            <div class="flex items-start justify-between">
              <span class="font-mono text-[10px] tracking-[0.16em] text-accent">{String(index + 1).padStart(2, '0')}</span>
              <span class="text-muted transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span>
            </div>
            <div class="mt-8">
              <h3 class="text-lg font-semibold tracking-tight">{link.label}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{link.description}</p>
            </div>
          </a>
        </Reveal>
      ))}
    </div>
  </div>
</section>
