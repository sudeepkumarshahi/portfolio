---
import SectionHeading from './SectionHeading.astro';
import Reveal from './Reveal.astro';
import { profile, socials } from '../data/site';
---

<section class="bg-surface pt-28 pb-20 sm:pt-36 sm:pb-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading title="Let's build something" />

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {socials.map((social, index) => (
        <Reveal delay={index * 90} class="h-full">
          <a
            href={social.href}
            target={social.href.startsWith('http') ? '_blank' : undefined}
            rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="social-card group relative flex h-full min-h-[168px] flex-col justify-between rounded-2xl border border-line bg-bg p-6"
          >
            <div class="flex items-start justify-between">
              <span class="social-icon grid h-11 w-11 place-items-center rounded-xl border border-line bg-surface text-accent">
                {social.label === 'GitHub' && (
                  <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.94.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
                  </svg>
                )}
                {social.label === 'LinkedIn' && (
                  <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96C2 21.32 2.69 22 3.55 22h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM8.34 18.75H5.23V9.2h3.11v9.55ZM6.78 7.9a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6Zm11.97 10.85h-3.1V14.1c0-1.11-.02-2.53-1.54-2.53-1.55 0-1.79 1.21-1.79 2.45v4.73H9.23V9.2h2.98v1.3h.04c.41-.78 1.42-1.6 2.93-1.6 3.13 0 3.71 2.06 3.71 4.74v5.11Z" />
                  </svg>
                )}
                {social.label === 'Email' && (
                  <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                    <path d="m3 6 9 6.5L21 6" />
                  </svg>
                )}
                {social.label === 'Phone' && (
                  <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 16.4v2.7a2 2 0 0 1-2.2 2A17.8 17.8 0 0 1 3 5.2 2 2 0 0 1 5 3h2.7a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8.2 10.6a14 14 0 0 0 5.2 5.2l1.2-1.6a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2.1Z" />
                  </svg>
                )}
              </span>
              <span class="text-muted transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1" aria-hidden="true">↗</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold tracking-tight">{social.label}</h3>
              <p class="mt-1 break-all font-mono text-[11px] text-muted">{social.handle}</p>
            </div>
          </a>
        </Reveal>
      ))}
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <Reveal>
        <p class="text-2xl font-medium leading-snug tracking-tight sm:text-3xl">
          I'd love to hear what you're working on.
        </p>
        <a
          href={`mailto:${profile.email}`}
          class="mt-8 inline-flex items-center gap-2 border-b border-accent pb-1 font-mono text-sm text-accent"
        >
          {profile.email}
          <span aria-hidden="true">↗</span>
        </a>
      </Reveal>

      <Reveal delay={120}>
        <form
          action="https://formspree.io/f/REPLACE_WITH_YOUR_FORM_ID"
          method="POST"
          class="rounded-2xl border border-line bg-bg p-6 sm:p-8"
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">Your name</span>
              <input
                type="text"
                name="name"
                required
                autocomplete="name"
                placeholder="Ada Lovelace"
                class="mt-2 w-full rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm outline-none transition-colors placeholder:text-muted/60 focus:border-accent"
              />
            </label>
            <label class="block">
              <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">Your email</span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                placeholder="ada@example.com"
                class="mt-2 w-full rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm outline-none transition-colors placeholder:text-muted/60 focus:border-accent"
              />
            </label>
          </div>

          <label class="mt-5 block">
            <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted">Message</span>
            <textarea
              name="message"
              rows="5"
              required
              placeholder="Tell me about the role, project, or idea..."
              class="mt-2 w-full resize-y rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm outline-none transition-colors placeholder:text-muted/60 focus:border-accent"
            ></textarea>
          </label>

          <button type="submit" class="btn btn-solid mt-6 inline-flex items-center gap-2 rounded-lg px-5 py-3 text-sm font-medium">
            Send message
            <span class="arrow" aria-hidden="true">↗</span>
          </button>
          <p class="mt-3 font-mono text-[10px] text-muted">Replace the Formspree form ID before launching.</p>
        </form>
      </Reveal>
    </div>
  </div>
</section>
