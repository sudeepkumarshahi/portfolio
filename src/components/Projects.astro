---
import SectionHeading from './SectionHeading.astro';
import ProjectVisual from './ProjectVisual.astro';
import { projects } from '../data/site';
---

<section class="bg-surface pt-28 pb-20 sm:pt-36 sm:pb-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading title="Projects" />

    <div class="relative">
      <div class="pointer-events-none select-none opacity-40 blur-[5px] saturate-50" aria-hidden="true" inert>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <div class="h-full">
              <article class="flex h-full flex-col rounded-2xl border border-line bg-bg p-4 sm:p-5">
                <ProjectVisual variant={project.variant} />

                <div class="mt-5 flex items-center justify-between font-mono text-[10px] uppercase tracking-[0.14em] text-muted">
                  <span>{project.category}</span>
                  <span>{project.year}</span>
                </div>

                <h3 class="mt-3 text-lg font-semibold tracking-tight">{project.title}</h3>
                <p class="mt-2 text-sm leading-6 text-muted">{project.subtitle}</p>

                <div class="mt-4 flex flex-wrap gap-1.5">
                  {project.tags.slice(0, 3).map((tag) => (
                    <span class="rounded border border-line px-2 py-1 font-mono text-[10px] text-muted">{tag}</span>
                  ))}
                </div>

                <div class="mt-5 flex items-baseline gap-2 border-t border-line pt-4">
                  <span class="font-mono text-xl font-medium text-accent">{project.metric}</span>
                  <span class="text-xs text-muted">{project.metricLabel}</span>
                </div>

                <div class="mt-4 flex items-center gap-4 text-xs font-medium text-muted">
                  <span>Case study →</span>
                  <span>Code ↗</span>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>

      <div class="absolute inset-0 grid place-items-center px-4">
        <div
          data-reveal
          class="w-full max-w-lg rounded-2xl border border-line bg-bg/90 px-6 py-9 text-center shadow-lg backdrop-blur-md sm:px-10 sm:py-11"
        >
          <span class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent-soft px-3 py-1.5 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-accent">
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"></span>
            In progress
          </span>

          <h3 class="mt-6 text-2xl font-semibold tracking-tight sm:text-3xl">Projects are being built</h3>
          <p class="mx-auto mt-4 max-w-sm text-sm leading-7 text-muted">
            I'm working on new data science projects. Case studies, code, and results will appear here soon.
          </p>

          <div class="mx-auto mt-8 h-1 w-48 overflow-hidden rounded-full bg-surface-2">
            <span class="build-bar block h-full w-1/3 rounded-full bg-accent"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
