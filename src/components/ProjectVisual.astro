---
interface Props {
  variant: 'bars' | 'line' | 'scatter';
}

const { variant } = Astro.props;
---

<div class="relative overflow-hidden rounded-xl border border-line bg-surface p-4">
  <svg viewBox="0 0 400 200" class="h-44 w-full sm:h-48" role="img" aria-label="Abstract data visualization">
    <g stroke="currentColor" class="text-line" stroke-width="1">
      <path d="M0 40H400M0 80H400M0 120H400M0 160H400" />
    </g>

    {variant === 'bars' && (
      <g class="text-accent" fill="currentColor">
        <rect class="bar" style="animation-delay: 120ms" x="42" y="116" width="34" height="44" rx="4" opacity="0.35" />
        <rect class="bar" style="animation-delay: 200ms" x="90" y="92" width="34" height="68" rx="4" opacity="0.5" />
        <rect class="bar" style="animation-delay: 280ms" x="138" y="104" width="34" height="56" rx="4" opacity="0.4" />
        <rect class="bar" style="animation-delay: 360ms" x="186" y="66" width="34" height="94" rx="4" opacity="0.7" />
        <rect class="bar" style="animation-delay: 440ms" x="234" y="80" width="34" height="80" rx="4" opacity="0.55" />
        <rect class="bar" style="animation-delay: 520ms" x="282" y="46" width="34" height="114" rx="4" />
        <rect class="bar" style="animation-delay: 600ms" x="330" y="62" width="34" height="98" rx="4" opacity="0.8" />
      </g>
    )}

    {variant === 'line' && (
      <g fill="none" stroke="currentColor" class="text-accent" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path class="mini-line" d="M20 148 C60 140 72 96 108 104 S164 152 200 122 S252 60 292 76 S344 118 380 44" />
        <path d="M20 148 C60 140 72 96 108 104 S164 152 200 122 S252 60 292 76 S344 118 380 44 L380 200 L20 200 Z" fill="currentColor" opacity="0.07" stroke="none" />
        <circle cx="108" cy="104" r="4" fill="currentColor" stroke="none" />
        <circle cx="200" cy="122" r="4" fill="currentColor" stroke="none" />
        <circle cx="292" cy="76" r="4" fill="currentColor" stroke="none" />
        <circle cx="380" cy="44" r="4" fill="currentColor" stroke="none" />
      </g>
    )}

    {variant === 'scatter' && (
      <g class="text-accent" fill="currentColor">
        <circle cx="64" cy="140" r="6" opacity="0.5" />
        <circle cx="96" cy="112" r="4" opacity="0.7" />
        <circle cx="128" cy="148" r="7" opacity="0.35" />
        <circle cx="152" cy="80" r="5" opacity="0.8" />
        <circle cx="188" cy="104" r="6" opacity="0.55" />
        <circle cx="214" cy="56" r="4" opacity="0.9" />
        <circle cx="248" cy="92" r="8" opacity="0.3" />
        <circle cx="276" cy="124" r="5" opacity="0.6" />
        <circle cx="312" cy="68" r="6" opacity="0.75" />
        <circle cx="344" cy="96" r="4" opacity="0.5" />
        <circle cx="372" cy="48" r="7" opacity="0.4" />
      </g>
    )}
  </svg>

  <div class="mt-3 flex items-center justify-between font-mono text-[10px] uppercase tracking-widest text-muted">
    <span>figure / {variant}</span>
    <span>sample data</span>
  </div>
</div>

<style>
  .bar {
    transform-box: fill-box;
    transform-origin: bottom;
    animation: bar-grow 750ms var(--ease-soft) both;
  }

  .mini-line {
    stroke-dasharray: 520;
    stroke-dashoffset: 520;
    animation: draw-line 1300ms var(--ease-soft) 150ms forwards;
  }

  @keyframes bar-grow {
    from {
      transform: scaleY(0.05);
      opacity: 0;
    }
  }

  @keyframes draw-line {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar,
    .mini-line {
      animation: none;
      transform: none;
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
</style>
